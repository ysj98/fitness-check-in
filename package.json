{
  "name": "fitness-check-in",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "description": "微信运动打卡、体重和 BMI 管理小程序",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "prepare": "node ./scripts/create-base-files.js",
    "dev": "uni -p mp-weixin",
    "dev:mp": "uni -p mp-weixin",
    "dev:mp:test": "uni -p mp-weixin --mode test",
    "dev:mp:prod": "uni -p mp-weixin --mode production",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build": "uni build -p mp-weixin",
    "build:mp": "uni build -p mp-weixin",
    "build:mp:test": "uni build -p mp-weixin --mode test",
    "build:mp:prod": "uni build -p mp-weixin --mode production",
    "build:mp-weixin": "uni build -p mp-weixin",
    "upload:mp": "node ./scripts/upload-weixin.js",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4070620250821001",
    "@dcloudio/uni-components": "3.0.0-4070620250821001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4070620250821001",
    "@qiun/ucharts": "2.5.0-20230101",
    "pinia": "2.0.36",
