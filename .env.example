# WeChat Mini Program
WECHAT_APPID=your_wechat_mini_program_appid
WECHAT_SECRET=your_wechat_mini_program_appsecret

# JWT
JWT_SECRET=replace-with-a-long-random-secret

# MySQL container
MYSQL_DATABASE=fitness_check_in
MYSQL_USER=fitness
MYSQL_PASSWORD=replace-with-mysql-user-password
MYSQL_ROOT_PASSWORD=replace-with-mysql-root-password

# API server
PORT=3000
HOST=0.0.0.0
NODE_OPTIONS=--max-old-space-size=256

# Docker resource limits for 2 vCPU / 2 GiB ECS
API_CPUS=0.75
API_MEMORY=384m
MYSQL_CPUS=1.00
MYSQL_MEMORY=768m

# MySQL lightweight runtime settings
MYSQL_CONNECTION_LIMIT=5
MYSQL_MAX_CONNECTIONS=50
MYSQL_INNODB_BUFFER_POOL_SIZE=256M
