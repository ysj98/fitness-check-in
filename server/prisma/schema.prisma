generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int            @id @default(autoincrement())
  openid         String         @unique
  nickname       String         @default("运动达人")
  avatarUrl      String?
  gender         String?
  birthday       String?
  dailyGoal      Int            @default(1)
  heightCm       Decimal?       @db.Decimal(5, 2)
  targetWeightKg Decimal?       @db.Decimal(5, 2)
  weightUnit     String         @default("kg") @db.VarChar(8)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  checkIns       CheckIn[]
  weightRecords  WeightRecord[]

  @@map("users")
}

model WeightRecord {
  id         Int      @id @default(autoincrement())
  userId     Int
  weightKg   Decimal  @db.Decimal(5, 2)
  measuredAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, measuredAt])
  @@map("weight_records")
}

model CheckIn {
  id              Int      @id @default(autoincrement())
  userId          Int
  checkedAt       DateTime @default(now())
  createdAt       DateTime @default(now())
  isBackfill      Boolean  @default(false)
  backfillReason  String?  @db.VarChar(32)
  sportType       String   @default("其他") @db.VarChar(16)
  durationMinutes Int      @default(30)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, checkedAt])
  @@map("check_ins")
}
