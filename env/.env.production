# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'production'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = false
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

# production mode 后台请求地址
VITE_SERVER_BASEURL = 'https://fitness.nexigo.cn'
# VITE_SERVER_BASEURL__WEIXIN_TRIAL = 'https://trial-api.example.com'
VITE_SERVER_BASEURL__WEIXIN_DEVELOP = 'https://fitness.nexigo.cn'
VITE_SERVER_BASEURL__WEIXIN_RELEASE = 'https://fitness.nexigo.cn'
